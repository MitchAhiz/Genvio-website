DATABASE_URL=""
ADMIN_EMAIL=""
BREVO_API_KEY=""

# Supabase Storage — private bucket for payment receipts. The service role
# key is server-side only; never expose it via a VITE_ env var or ship it to
# the frontend.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_RECEIPTS_BUCKET="payment-receipts"

# Public bucket for product photos/cards from the /upload form. Unlike
# the receipts bucket, this one is public — product images are served
# straight from Storage's public URL to the storefront.
PRODUCT_IMAGES_BUCKET="product-images"

# Used by POST /admin/upload/generate-card and /admin/upload/suggest
# (the /upload form's AI features — product-upload-project.md §3). Both
# routes return 503 rather than erroring if this is unset — set it only
# once GEMINI_API_KEY is genuinely ready to use.
GEMINI_API_KEY=""

# Used to build the "open this order in the admin" link in the
# receipt-uploaded alert email, and the re-upload link in the rejection
# email. Defaults to the known Vercel URL if unset.
FRONTEND_URL=""

# Optional extra CORS origin (the Vercel URL is already allowed in code)
CORS_ORIGIN=""

# Bank transfer details shown at checkout. Change here, no code deploy needed.
BANK_NAME=""
BANK_ACCOUNT_NUMBER=""
BANK_ACCOUNT_NAME=""
