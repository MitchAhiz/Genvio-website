generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  brand         String
  price         Int
  section       String   @default("women")
  status        String   @default("draft")
  categoryId    String?  @map("category_id")
  subcategoryId String?  @map("subcategory_id")
  createdBy     String?  @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")

  images      ProductImage[]
  variants    ProductVariant[]
  category    Category?        @relation(fields: [categoryId], references: [id])
  subcategory Subcategory?     @relation(fields: [subcategoryId], references: [id])

  @@index([section, status])
  @@map("products")
}

// Lightweight lookup keyed by phone number — not an account system.
model Customer {
  id      String  @id @default(cuid())
  phone   String  @unique
  name    String
  email   String?
  // Whether `phone` is reachable on WhatsApp. Defaults true (the checkbox is
  // ticked by default); the shop does not require WhatsApp, only prefers it.
  isWhatsapp Boolean @default(true) @map("is_whatsapp")
  address Json

  // Opt-in saved details. pinHash is a bcrypt hash of a 4-digit PIN and is
  // never returned by any endpoint; it is only ever compared against.
  pinHash      String?  @map("pin_hash")
  detailsSaved Boolean  @default(false) @map("details_saved")
  saveOptedOut Boolean  @default(false) @map("save_opted_out")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  orders Order[]

  @@map("customers")
}

model Order {
  id            String   @id @default(cuid())
  reference     String   @unique
  // Unguessable proof of ownership for the receipt-upload/lookup routes —
  // deliberately separate from `reference`, which is human-readable and
  // shown/typed as the transfer narration, so it can't double as a secret.
  // Database-level default (not just Prisma's client-side uuid()) so any
  // client — including the pre-Step-1 code still deployed on Render at the
  // time this was added — can INSERT a row without knowing this column
  // exists. Keep schema and DB in lockstep: see migration
  // 20260922130000_add_order_token_db_default.
  orderToken    String   @unique @default(dbgenerated("gen_random_uuid()::text")) @map("order_token")
  customerId    String   @map("customer_id")
  items         Json
  address       Json
  total         Int
  // pending_payment -> pending_verification -> confirmed -> processing ->
  // shipped -> delivered, with rejected branching off pending_verification
  // (a fresh upload on a rejected order returns it to pending_verification),
  // and expired for a pending_payment order that never got a receipt.
  status        String   @default("pending_payment")
  paymentMethod String   @default("bank_transfer") @map("payment_method")
  notes         String?  @db.Text
  // Stock stays reserved (see VariantSize.reservedQuantity) until this
  // passes without the order reaching confirmed; set on each receipt upload.
  reservedUntil DateTime? @map("reserved_until")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  customer Customer         @relation(fields: [customerId], references: [id])
  receipts PaymentReceipt[]

  @@index([status, createdAt])
  @@map("orders")
}

// A separate table (not a column on Order) so a rejected order can receive a
// new upload without overwriting the rejected one — admin sees every attempt.
model PaymentReceipt {
  id               String    @id @default(cuid())
  orderId          String    @map("order_id")
  storageKey       String    @map("storage_key")
  fileType         String    @map("file_type")
  fileSize         Int       @map("file_size")
  originalFilename String    @map("original_filename")
  storedFilename   String    @map("stored_filename")
  fileHash         String    @map("file_hash")
  // Same hash exists on a different order — still accepted, just flagged.
  isDuplicate      Boolean   @default(false) @map("is_duplicate")
  uploadedAt       DateTime  @default(now()) @map("uploaded_at")
  reviewedBy       String?   @map("reviewed_by")
  reviewedAt       DateTime? @map("reviewed_at")
  rejectionReason  String?   @db.Text @map("rejection_reason")

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, uploadedAt])
  @@index([fileHash])
  @@map("payment_receipts")
}

model WholesaleImage {
  id        String   @id @default(cuid())
  url       String
  caption   String?
  category  String?
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("wholesale_images")
}

model ProductImage {
  id        String @id @default(cuid())
  productId String @map("product_id")
  url       String
  sortOrder Int    @default(0) @map("sort_order")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model ProductVariant {
  id       String @id @default(cuid())
  productId String @map("product_id")
  colour   String
  imageUrl String? @map("image_url")
  // Real front/back photos (not the AI-generated card image above) — shown
  // in the storefront product-detail gallery. rawFrontUrl is required by the
  // application at write time; rawBackUrl is optional. See
  // product-upload-project.md §5.
  rawFrontUrl String? @map("raw_front_url")
  rawBackUrl  String? @map("raw_back_url")
  createdBy   String? @map("created_by")

  product Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  sizes   VariantSize[]
  images  VariantImage[]

  @@map("product_variants")
}

// Ordered images per colour (product card + gallery), with provenance —
// added alongside ProductVariant rather than folded into ProductImage,
// which stays product-scoped and untouched. See
// product-upload-project.md §4 Step 1 / §5b for why: Mode A can produce
// more than one generated image per photo set and Mode B can supply up
// to 3, and the two need to be distinguishable later. sortOrder 0 is the
// product card shown in the catalogue grid; >0 are gallery images, in
// order. Migration applied 2026-09-26:
// server/prisma/migrations/20260926140000_add_variant_images.
model VariantImage {
  id         String   @id @default(cuid())
  variantId  String   @map("variant_id")
  url        String
  sortOrder  Int      @default(0) @map("sort_order")
  provenance String
  createdBy  String?  @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([variantId, sortOrder])
  @@index([variantId])
  @@map("variant_images")
}

model VariantSize {
  id        String @id @default(cuid())
  variantId String @map("variant_id")
  size      String
  quantity  Int    @default(0)
  // Held by orders in pending_verification (Order.reservedUntil). Available
  // stock is always quantity - reservedQuantity; quantity itself is only
  // decremented when an order is confirmed. DB-enforced via the
  // variant_sizes_reserved_lte_quantity CHECK (reserved_quantity <= quantity)
  // added in the add_subcategories_and_size_ranges migration.
  reservedQuantity Int      @default(0) @map("reserved_quantity")
  updatedBy        String?  @map("updated_by")
  updatedAt        DateTime @default(now()) @updatedAt @map("updated_at")

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@map("variant_sizes")
}

// Second taxonomy level under Category (e.g. Category "Dresses" ->
// Subcategory "Midi", "Maxi"). Same shape and reassign-or-unpublish delete
// semantics as Category — see server/src/services/categoryService.js and
// the commit history behind server/prisma/migrations/
// 20260916090000_rename_subcategory_to_category for why that pattern
// exists and why it's being mirrored rather than reinvented.
model Subcategory {
  id         String   @id @default(cuid())
  categoryId String   @map("category_id")
  name       String
  createdBy  String   @map("created_by")
  createdAt  DateTime @default(now()) @map("created_at")

  category   Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  products   Product[]
  sizeRanges SizeRange[]

  @@unique([categoryId, name])
  @@map("subcategories")
}

// One ordered list of size labels per (category, subcategory) pair — drives
// the Step 4 stock grid in the upload form. See product-upload-project.md
// §4 Step 4 / §8. Deliberately a single JSONB array column, not a child
// rows-per-size table: there's no per-size metadata beyond display order,
// so a join table would be pure ceremony (CLAUDE.md §10: don't
// over-engineer).
model SizeRange {
  id            String   @id @default(cuid())
  categoryId    String   @map("category_id")
  subcategoryId String   @map("subcategory_id")
  sizes         Json
  createdBy     String   @map("created_by")
  updatedBy     String?  @map("updated_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at")

  category    Category    @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  subcategory Subcategory @relation(fields: [subcategoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, subcategoryId])
  @@map("size_ranges")
}

model SiteConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_config")
}

model Category {
  id        String   @id @default(cuid())
  name      String
  // Nullable since the Men/Women/Kids restructure (migration
  // 20260925120000_add_men_women_kids_parent_categories): the 3 new
  // top-level rows have no section of their own -- they ARE the section.
  // Only the 6 pre-existing rows (now also Subcategory rows) still carry
  // a value here, kept untouched pending Migration B.
  section   String?
  createdAt DateTime @default(now()) @map("created_at")

  products      Product[]
  subcategories Subcategory[]
  sizeRanges    SizeRange[]

  @@map("categories")
}

model ActivityLog {
  id         String   @id @default(cuid())
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  detail     Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("activity_log")
}

model ConfigChangeHistory {
  id        String   @id @default(cuid())
  key       String
  oldValue  String?  @map("old_value")
  newValue  String   @map("new_value")
  changedAt DateTime @default(now()) @map("changed_at")

  @@map("config_change_history")
}
