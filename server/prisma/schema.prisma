generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Product {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  brand         String
  category      String
  price         Int
  section       String   @default("women")
  status        String   @default("draft")
  subcategoryId String?  @map("subcategory_id")
  createdAt     DateTime @default(now()) @map("created_at")

  images      ProductImage[]
  variants    ProductVariant[]
  subcategory Subcategory?     @relation(fields: [subcategoryId], references: [id])

  @@index([section, status])
  @@map("products")
}

// Lightweight lookup keyed by phone number — not an account system.
model Customer {
  id      String  @id @default(cuid())
  phone   String  @unique
  name    String
  email   String?
  address Json

  // Opt-in saved details. pinHash is a bcrypt hash of a 4-digit PIN and is
  // never returned by any endpoint; it is only ever compared against.
  pinHash      String?  @map("pin_hash")
  detailsSaved Boolean  @default(false) @map("details_saved")
  saveOptedOut Boolean  @default(false) @map("save_opted_out")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  orders Order[]

  @@map("customers")
}

model Order {
  id            String   @id @default(cuid())
  reference     String   @unique
  customerId    String   @map("customer_id")
  items         Json
  address       Json
  total         Int
  status        String   @default("pending_payment")
  paymentMethod String   @default("bank_transfer") @map("payment_method")
  notes         String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  customer Customer @relation(fields: [customerId], references: [id])

  @@index([status, createdAt])
  @@map("orders")
}

model WholesaleImage {
  id        String   @id @default(cuid())
  url       String
  caption   String?
  category  String?
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("wholesale_images")
}

model ProductImage {
  id        String @id @default(cuid())
  productId String @map("product_id")
  url       String
  sortOrder Int    @default(0) @map("sort_order")

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_images")
}

model ProductVariant {
  id       String @id @default(cuid())
  productId String @map("product_id")
  colour   String
  imageUrl String? @map("image_url")

  product Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  sizes   VariantSize[]

  @@map("product_variants")
}

model VariantSize {
  id        String @id @default(cuid())
  variantId String @map("variant_id")
  size      String
  quantity  Int    @default(0)

  variant ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@map("variant_sizes")
}

model SiteConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("site_config")
}

model Subcategory {
  id        String   @id @default(cuid())
  name      String
  section   String
  createdAt DateTime @default(now()) @map("created_at")

  products Product[]

  @@map("subcategories")
}

model ActivityLog {
  id         String   @id @default(cuid())
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  detail     Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@map("activity_log")
}

model ConfigChangeHistory {
  id        String   @id @default(cuid())
  key       String
  oldValue  String?  @map("old_value")
  newValue  String   @map("new_value")
  changedAt DateTime @default(now()) @map("changed_at")

  @@map("config_change_history")
}
